#!/bin/sh
# Launcher for typetrainer. Works when run directly OR via a symlink on PATH.
# Resolve symlinks to find the real script directory.
SRC="$0"
while [ -h "$SRC" ]; do
    DIR=$(cd -P "$(dirname "$SRC")" && pwd)
    SRC=$(readlink "$SRC")
    case "$SRC" in
        /*) ;;
        *) SRC="$DIR/$SRC" ;;
    esac
done
DIR=$(cd -P "$(dirname "$SRC")" && pwd)
exec python3 "$DIR/typetrainer.py" "$@"
